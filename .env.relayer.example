NEXT_PUBLIC_ARC_NETWORK=mainnet
# Keep the real .env.relayer private. Use the same Neon database as the app.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_POOL_MAX=2
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Required on mainnet. Never use the testnet contract address.
PREPAID_CONTRACT_ADDRESS=
# Dedicated funded EOA. Never use NEXT_PUBLIC_ for this key.
RELAYER_PRIVATE_KEY=
# Public address; allows dry runs without supplying a private key.
RELAYER_ADDRESS=
RELAYER_BATCH_SIZE=5
RELAYER_MAX_BATCHES=3
RELAYER_MAX_GAS_COST_USDC=0.10
RELAYER_ALLOW_UNPROFITABLE=true
RELAYER_MAX_LOSS_USDC=0.02
# Applies only when ALLOW_UNPROFITABLE=false.
RELAYER_MIN_PROFIT_USDC=0
