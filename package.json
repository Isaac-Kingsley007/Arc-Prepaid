{
  "name": "arc-prepaid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --conditions=react-server --env-file=.env.local scripts/db-migrate.ts",
    "db:check": "tsx --conditions=react-server --env-file=.env.local scripts/db-check.ts",
    "db:test": "tsx --conditions=react-server --test lib/db/*.test.ts",
    "check:receive:testnet": "tsx scripts/check-receive-with-authorization.ts testnet",
    "check:receive:mainnet": "tsx scripts/check-receive-with-authorization.ts mainnet",
    "contracts:build": "pnpm --filter @prepaid/contracts build",
    "contracts:test": "pnpm --filter @prepaid/contracts test",
    "contracts:typecheck": "pnpm --filter @prepaid/contracts typecheck",
    "contracts:check:testnet": "pnpm contracts:build && tsx --env-file=.env.testnet scripts/deploy-testnet.mts --check",
    "contracts:deploy:testnet": "pnpm contracts:build && tsx --env-file=.env.testnet scripts/deploy-testnet.mts --deploy"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1"
}
