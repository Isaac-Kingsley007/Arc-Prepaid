# Server-side only. Paste your Neon pooled connection URL here; never use NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_POOL_MAX=3

# Public Reown project ID for RainbowKit/WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Current database-based PrePaid contract, not the earlier on-chain-storage deployment.
PREPAID_CONTRACT_ADDRESS=
# Required in production; must match the URL users visit. No trailing path.
APP_ORIGIN=http://localhost:3000
# Optional server-side RPC override; phase 1 uses Arc testnet.
ARC_RPC_URL=https://rpc.testnet.arc.io
